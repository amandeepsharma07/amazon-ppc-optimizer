# Postgres connection string. On Vercel use Neon, Supabase or Vercel Postgres.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Created the first time you run the database setup.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-immediately
